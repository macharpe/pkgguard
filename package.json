{
  "name": "pkgguard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p scripts --noEmit",
    "test:coverage": "vitest run --coverage",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "deploy:config:filter": "tsx scripts/generate-deploy-config.ts filter",
    "deploy:filter": "npm run deploy:config:filter && wrangler deploy -c workers/filter/wrangler.local.jsonc"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/yauzl": "^3.4.0",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "yauzl": "^3.4.0"
  }
}

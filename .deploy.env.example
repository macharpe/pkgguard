# Copy to .deploy.env (gitignored), fill in the real identifiers, then run `npm run deploy`.
# Shell environment variables with these names take precedence over this file.

PKGGUARD_ACCOUNT_ID=<your-32-hex-account-id>
PKGGUARD_ADMIN_HOSTNAME=pkgguard.<your-domain>
PKGGUARD_TEAM_DOMAIN=<your-team>.cloudflareaccess.com
PKGGUARD_ACCESS_AUD=<64-hex audience tag of the Access application>
PKGGUARD_KV_ID=<your-32-hex-kv-namespace-id>
PKGGUARD_D1_ID=<your-d1-database-uuid>

# Gateway Forward rule (scripts/gateway-rule.ts). Comma-separated entries: an email address, or @domain.tld for
# everyone at that domain, e.g. "@example.com,ops@partner.example". The rule is never unscoped: an empty value fails.
# The API token is read from TF_VAR_cloudflare_api_token (never the bare CLOUDFLARE_API_TOKEN name).
PKGGUARD_SCOPE=<@your-domain>
# Optional. "true" makes the filter block malware; unset or "false" is observe-only (recorded, never blocked).
# Anything else is an error. The deploy prints the mode it wrote.
# PKGGUARD_ENFORCE=false
# Optional, default 47000. Must stay above any static pkg.* policies.
# PKGGUARD_FORWARD_PRECEDENCE=47000

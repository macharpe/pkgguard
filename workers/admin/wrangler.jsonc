// Committed template: placeholder IDs only. Real values live in .deploy.env;
// `npm run deploy:config:admin` writes the gitignored wrangler.local.jsonc used for deploys.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pkgguard-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-06",
  "account_id": "00000000000000000000000000000000",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "pkgguard.example.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "workflows": [{ "name": "pkgguard-refresh", "binding": "REFRESH", "class_name": "RefreshWorkflow" }],
  // 03:00 UTC on the 1st (monthly) and 04:00 UTC daily. Both run the same idempotent delta.
  "triggers": { "crons": ["0 3 1 * *", "0 4 * * *"] },
  // A refresh makes a fetch, and D1/KV calls, per record. The default is 10,000 per instance.
  "limits": { "subrequests": 50000 },
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "kv_namespaces": [{ "binding": "PKG_INDEX", "id": "00000000000000000000000000000001" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "pkgguard-db", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "vars": {
    "TEAM_DOMAIN": "your-team.cloudflareaccess.com",
    "ACCESS_AUD": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
  }
}
